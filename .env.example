# Generated by scripts/bootstrap.sh (never commit the real .env)
SENTINEL_HOST_IP=192.168.1.200
# Core tokens are stored in ./secrets/api_token and ./secrets/ingest_token
# They MUST NOT appear in .env or Docker Compose environment.
# Optional read-only API sources: off until explicitly configured.
SENTINEL_ADGUARD_ENABLED=false
SENTINEL_ADGUARD_URL=https://192.168.1.1:3000/
SENTINEL_ADGUARD_USERNAME=sentinel
SENTINEL_ADGUARD_POLL_SECS=30
SENTINEL_ADGUARD_PAGE_LIMIT=200
SENTINEL_ADGUARD_MAX_PAGES=15
SENTINEL_ADGUARD_INITIAL_LOOKBACK_MINS=15
# CA path in container, if the upstream uses private PKI:
SENTINEL_ADGUARD_CA_FILE=
SENTINEL_CROWDSEC_ENABLED=false
SENTINEL_CROWDSEC_URL=https://192.168.1.1:8080/
SENTINEL_CROWDSEC_POLL_SECS=30
SENTINEL_CROWDSEC_MAX_DECISIONS=3000
SENTINEL_CROWDSEC_CA_FILE=
# Set true ONLY when using a private isolated management network and API has HTTP only.
SENTINEL_ALLOW_HTTP_UPSTREAMS=false

# Phase 3 deterministic detection; configure after measuring your own baseline.
SENTINEL_DETECTION_INTERVAL_SECS=5
SENTINEL_DETECTION_BATCH_SIZE=150
SENTINEL_RULE_FIREWALL_BLOCKS=12
SENTINEL_RULE_DNS_PER_MIN=120
SENTINEL_RULE_ADMIN_PROBES=5
SENTINEL_RULE_OUTBOUND_FANOUT=25
SENTINEL_RULE_DNS_ANOMALY_MIN=40
SENTINEL_BASELINE_MIN_QUERIES=200

# Phase 4: docker compose --profile ollama up -d ollama;
# then docker compose --profile agent run --rm agent --ip 203.0.113.7
# Leave the LLM remote if the telemetry VM lacks RAM / acceleration.
SENTINEL_OLLAMA_URL=http://ollama:11434/
SENTINEL_LLM_MODEL=qwen3:4b
# Harness read & report tokens are generated into secrets/ (not env values).
# Additional model endpoint trust; keep false by default.
SENTINEL_ALLOW_HTTP_MODEL=false
SENTINEL_OLLAMA_CA_FILE=

# Phase 6: response tokens are separate secret files, not environment values.
# Dashboard: localhost:8765/ui via an SSH tunnel. Browser holds token only in RAM.
# Live-firewall execution is NOT included; response-gateway supports simulation.
